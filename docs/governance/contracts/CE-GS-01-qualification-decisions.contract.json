      "label": "路线 A：保留人工发布资格（现行门禁，继续有效）",
      "uses": ["真实发布（含真实儿童/家长/教师使用）前的全部资产"],
      "review_method": [
        "Evidence 层：领域审核人 approved（成熟度 L3，gold）",
        "Knowledge 层：知识负责人版本化知识包发布（manifest 哈希）",
        "Agent 层：产品负责人显式批准 + 回归评测用例（KNOWLEDGE_GOVERNANCE §2–§4）"
      ],
      "approval_conditions": [
        "CE-01R-CHECKLIST 人工签署生效（当前未签署，四份规程 DRAFT v1.1）",
        "满足 gold 资格流程：独立双人一致或裁决 + 知识负责人签署（LT-03/LT-04）",
        "#2 类人工标注/复核资源按 GS-D2 决定落实"
      ],
      "unverified": [
        "现实条件：当前无第二名人工 Reviewer（R9），人工复核资源存在阻塞",
        "四份规程与 CE-01R 契约仍为待人工审核，未生效"
      ]
    },
    "ai_review_trial": {
      "label": "路线 B：低风险私有 AI 审查试用资格（提案，未被预先选择）",
      "uses": [
        "低风险、私有研究试用范围内的受限资产",
        "不包含真实发布、真实儿童正式行为资产或批量科研审查"
      ],
      "review_method": [
        "技术校验（结构/哈希/引用/可执行状态）单独留痕",
        "AI 审查留痕：review_origin 如实标记 ai_draft / multi_model_consistent，不伪造人工身份",
        "用途限定 + 未验证部分显式声明；独立科学验证缺口如实标注，不冒充人工 Gold"
      ],
      "approval_conditions": [
        "GS-D1 由用户真实决定启用，且明确用途清单",
        "同版本修订四份科研规程、AGENTS、治理契约并通过一致性测试",
        "保留未验证声明：AI 审查的科学效度无独立验证；多模型一致投票不等于专家共识（AGENTS #18）"
      ],
      "unverified": [
        "AI 审查产出的科学效度未经独立人工验证",
        "AI 一致性不能产生人工 Gold（LT-03/LT-04、GS-02）",
        "长期行为影响与个体适用性未验证"
      ]
    }
  },
