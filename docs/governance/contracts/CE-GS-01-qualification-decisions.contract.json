  "separation_dimensions": [
    {
      "id": "data_processing_permission",
      "name_zh": "资料处理权限",
      "definition": "哪些来源可被读取、解析、外发给模型；由权限登记与预检决定",
      "distinct_from": "与审核来源分离：有权限处理不等于已审核，更不等于可发布",
      "existing_basis": "AGENTS #6/#8；model_access 登记（POLICY_ACTIVE=False）；权限预检"
    },
    {
      "id": "technical_validation",
      "name_zh": "技术校验",
      "definition": "结构、引用、哈希与可执行状态检查",
      "distinct_from": "与科学评价分离：结构正确不等于科研结论成立",
      "existing_basis": "contracts.md §1.1；manifest 哈希复算（KNOWLEDGE_GOVERNANCE §4）"
    },
    {
      "id": "scientific_appraisal",
      "name_zh": "科学评价",
      "definition": "研究质量、偏倚、局限、不确定性与适用性评价",
      "distinct_from": "与模型自信、审核来源、发布资格分开；允许争议与不足",
      "existing_basis": "contracts.md §1.1 Appraisal；RESEARCH_METHODOLOGY 证据分级"
    },
    {
      "id": "review_origin",
      "name_zh": "审核来源",
      "definition": "实际审核方式：AI / 单人 / 独立人工复核等，如实标记不伪造身份",
      "distinct_from": "与发布资格分离：AI 一致性不能产生人工 Gold 或发布资格",
      "existing_basis": "AGENTS #18；label-tiers 契约 LT-03/LT-04"
    },
    {
      "id": "release_eligibility",
      "name_zh": "发布资格",
      "definition": "依据哪一版治理规则、允许什么用途、由何记录决定可发布",
      "distinct_from": "与技术校验/科学评价分离：任一单项通过不构成发布资格",
      "existing_basis": "KNOWLEDGE_GOVERNANCE §2–§4；本契约 GS-01..GS-05"
    },
    {
      "id": "runtime_applicability",
      "name_zh": "个体适用性",
      "definition": "当前情境是否具备使用条件，由运行时决定",
      "distinct_from": "与科研等级分离：个体适用性不得提升科研等级或证据强度",
      "existing_basis": "contracts.md §1.1 runtime_applicability；AGENTS #4"
    }
  ],
  "non_redundancy_rule": "一项检查只服务一个维度；禁止用重复执行同一检查充当另一维度的审批（不增加没有实际作用的重复审批）。",
  "review_origin_families": {
    "human": ["single_human", "independent_double_human", "adjudicated_human"],
    "non_human": ["ai_draft", "multi_model_consistent"],
    "ai_consistency_rule": "multi_model_consistent（多模型一致投票）属于非人工来源，不得产生或替代人工 Gold，不得获得发布资格（AGENTS #18；LT-03/LT-04；GS-02）"
  },
  "data_boundaries": {
    "research_library": {
      "definition": "科研文献库：SQLite 唯一事实源，追加式审计，不收儿童个人档案",
      "constraints": ["subject_ref 必须为空（GS-06）", "审计记录只追加不删除（AGENTS #2）"]
    },
    "personal_growth_record": {
      "definition": "个人成长记录：宿主管理落盘、授权、导出、纠正与删除",
      "constraints": ["host_managed 与 correction_supported 必须为 true（GS-06）", "默认不回流科研库、训练或评测数据集（contracts.md §5）"]
    }
  },
  "schema": {
    "type": "object",
    "required": ["record_id", "asset_kind", "asset_ref", "revision", "data_boundary", "decision_status"],
    "properties": {
      "record_id": {"type": "string", "minLength": 3},
      "asset_kind": {"type": "string", "enum": ["evidence_pack", "support_method", "interaction_profile", "strategy"]},
      "asset_ref": {"type": "string", "minLength": 3},
      "revision": {"type": "integer"},
      "data_boundary": {"type": "string", "enum": ["research_library", "personal_growth_record"]},
      "basis_kind": {"type": ["string", "null"], "enum": ["direct_research", "research_synthesis", "application_inference", "design_choice", null]},
      "basis_refs": {"type": "array", "items": {"type": "string"}},
      "review_origin": {"type": ["string", "null"], "enum": ["ai_draft", "multi_model_consistent", "single_human", "independent_double_human", "adjudicated_human", null]},
      "technical_validation": {"type": ["string", "null"], "enum": ["passed", "failed", "not_run", null]},
      "scientific_appraisal": {"type": ["string", "null"], "enum": ["done", "pending", "none", null]},
      "decision_status": {"type": "string", "enum": ["pending", "approved", "revoked"]},
      "approved_by": {"type": ["string", "null"]},
      "approved_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "decision_record_ref": {"type": ["string", "null"]},
      "revoked_reason": {"type": ["string", "null"]},
      "revoked_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "runtime_effect": {"type": ["string", "null"], "enum": ["new_version_release", "immediate", null]},
      "evaluation_refs": {"type": "array", "items": {"type": "string"}},
      "subject_ref": {"type": ["string", "null"]},
      "host_managed": {"type": ["boolean", "null"]},
      "correction_supported": {"type": ["boolean", "null"]},
      "governance_doc_version": {"type": ["string", "null"]}
    }
  },
  "validation_rules": [
    {"rule_id": "GS-01", "expr": "decision_status == 'approved' implies approved_by 非空 and approved_date 匹配日期格式 and decision_record_ref 非空（发布资格必须指向真实人工决定记录）"},
    {"rule_id": "GS-02", "expr": "decision_status in [approved, revoked] implies review_origin in [single_human, independent_double_human, adjudicated_human]（获得发布/撤回状态必须携带人工审核来源；ai_draft、multi_model_consistent 与未标记来源永远停留在 pending——AI 一致性不能产生人工 Gold：AGENTS #18、LT-03/LT-04）"},
    {"rule_id": "GS-03", "expr": "decision_status == 'revoked' implies revoked_reason 非空 and revoked_date 匹配日期格式 and decision_record_ref 非空（撤回是追加状态：保留原 asset_ref/revision、理由与日期，不删除历史）"},
    {"rule_id": "GS-04", "expr": "asset_kind == 'interaction_profile' implies evaluation_refs 非空 and basis_refs 非空 and runtime_effect == 'new_version_release'（人格/表达资产任何版本——含首版 revision=1——都必须可评测、有依据，且只能作为新版本发布生效，不直接改写运行行为；review P1-1：不存在版本豁免）"},
    {"rule_id": "GS-05", "expr": "decision_status == 'approved' implies technical_validation == 'passed' and scientific_appraisal == 'done'（未审核/未校验内容保持 pending，拒绝进入已发布状态）"},
    {"rule_id": "GS-06", "expr": "data_boundary == 'research_library' implies subject_ref == null；data_boundary == 'personal_growth_record' implies host_managed == true and correction_supported == true（两类数据边界不得混用）"}
  ],
  "known_limitations": [
    {
      "id": "GS-LIM-01",
      "scope": "GS-03/GS-04 跨记录语义",
      "limitation": "本契约与 validate_release_decision_record 只校验单条记录的字段规则；追加式撤回（旧版本不被删除/改写）与版本链不可变属于跨记录审计，由后续实现任务（#12/#14/#15/#16 的发布器与审计层）执行。单记录校验通过不等于版本链完整性已证明；『以删除代替追加式撤回』在单记录内无法构造可执行负例，只能由跨记录校验拒绝。"
    },
    {
      "id": "GS-LIM-02",
      "scope": "GS-01 decision_record_ref",
      "limitation": "decision_record_ref 仅作引用存在性检查；其指向的决定记录的真实性由人工治理流程与审计保证，不在本契约机器校验范围内（approved 同时要求人工 review_origin 以收窄伪造面）。"
    }
  ],
